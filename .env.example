# rag-builder 环境变量（全部可留空——离线能力不受影响）

# ── 服务 ──
PORT=3015
HOST=127.0.0.1
# 数据根目录（知识库/嵌入缓存落盘处）
RAG_DATA_ROOT=./data

# ── LLM Key（env 注入，仓库不含任何真实密钥）──
# 嵌入模型 Key（DashScope 通义千问，text-embedding-v4）。
# 不填时自动降级为 TF-IDF 关键词向量，建索引/检索/问答链路照常可用
QWEN_KEY=
# 答案生成模型 Key（DeepSeek）。不填时 /api/rag/answer 返回检索结果（RETRIEVAL_ONLY 模式）
DEEPSEEK_KEY=

# ── 可选：模型覆盖 ──
RAG_DEFAULT_ANSWER_MODEL=deepseek-chat
